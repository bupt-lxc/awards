# 数据库
DB_ROOT_PASSWORD=change-me-root-password
DB_USER=awards_user
DB_PASSWORD=change-me-db-password
DB_NAME=awards_management

# 首次启动时用于创建管理员；管理员已存在后不会重置密码
ADMIN_DEFAULT_PASSWORD=change-me-admin-password

# JWT：生产环境请使用足够长的随机值
JWT_SECRET=change-me-to-a-random-256-bit-key
GIN_MODE=release

# 腾讯云 COS（留空时自动回退到 backend/uploads/certificates）
COS_SECRET_ID=
COS_SECRET_KEY=
COS_REGION=
COS_BUCKET=
COS_PUBLIC_URL=/static/certificates
